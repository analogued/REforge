# Normalize detected text files to LF and keep LF on checkout on every platform.
* text=auto eol=lf

# Preserve the original Kenney license notice, including its CRLF and spacing.
crates/reforge_sdl/assets/controller/source/kenney/NOTICE.txt -text whitespace=-blank-at-eol,cr-at-eol

# Preserve the formatting of the pinned NihAV source.
third_party/nihav/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
